# Clinical Rule: Recent final heart-rate reading in a temporal window
rule RecentTachycardiaRule:
    intent: "Detect a recent final heart-rate reading above the threshold"
    schedule: "every 5m"
    site: Cardiology

    bind hr_readings = Vitals.heart_rate where status == "final" within 30 minutes

    let max_hr := 120

    when hr_readings.latest >= max_hr within 15 minutes:
    then:
        alert: "Recent Tachycardia Observed", hr_readings.latest
        suppress: within 1 hours
end
